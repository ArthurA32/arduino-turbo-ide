{
  "appId": "com.antigravity.arduino-arm-turbo-ide",
  "productName": "Arduino Turbo IDE",
  "directories": {
    "output": "release"
  },
  "afterPack": "./scripts/after-pack.cjs",
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "bin/**/*",
    "src/version.json"
  ],
  "extraResources": [
    {
      "from": "src/version.json",
      "to": "version.json"
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      "nsis",
      "dir"
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Arduino Turbo IDE",
    "artifactName": "Arduino_Turbo_IDE_Setup_${arch}.${ext}",
    "uninstallDisplayName": "Arduino Turbo IDE"
  },
  "asar": false
}

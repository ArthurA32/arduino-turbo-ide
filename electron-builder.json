{
  "appId": "com.antigravity.arduino-arm-turbo-ide",
  "productName": "Arduino Turbo IDE",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "bin/**/*"
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "dir",
        "arch": ["x64", "arm64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },

  "asar": false
}

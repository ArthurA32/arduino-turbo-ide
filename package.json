{
  "name": "arduino-arm-turbo-ide",
  "productName": "Arduino Turbo IDE",
  "version": "0.2.8",
  "type": "module",
  "description": "IDE ultraleve e nativa para Arduino e ESP32 otimizada para Windows x64 e ARM64",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:x64": "node scripts/build-and-export.js --arch=x64",
    "build:arm64": "node scripts/build-and-export.js --arch=arm64",
    "build:all": "node scripts/build-and-export.js --arch=all",
    "bump:arm64": "node scripts/bump-version.js --arch=arm64",
    "bump:x64": "node scripts/bump-version.js --arch=x64",
    "test:backend": "vitest run tests/backend --reporter=junit --outputFile=./reports/backend-junit.xml",
    "test:frontend": "vitest run tests/frontend --reporter=junit --outputFile=./reports/frontend-junit.xml",
    "test:e2e": "vitest run tests/e2e --reporter=junit --outputFile=./reports/e2e-junit.xml",
    "test:all": "vitest run --reporter=junit --outputFile=./reports/all-junit.xml",
    "test:report": "node scripts/consolidar-relatorio.js"
  },
  "keywords": [
    "arduino",
    "esp32",
    "ide",
    "arm64",
    "x64",
    "windows"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "fast-xml-parser": "^5.11.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.0"
  }
}
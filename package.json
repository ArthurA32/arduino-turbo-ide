{
  "name": "arduino-arm-turbo-ide",
  "version": "1.0.0",
  "type": "module",
  "description": "IDE ultraleve e nativa para Arduino e ESP32 otimizada para Windows x64 e ARM64",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:x64": "node scripts/build-and-export.js --arch=x64",
    "build:arm64": "node scripts/build-and-export.js --arch=arm64",
    "build:all": "node scripts/build-and-export.js --arch=all"
  },
  "keywords": [
    "arduino",
    "esp32",
    "ide",
    "arm64",
    "x64",
    "windows"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
